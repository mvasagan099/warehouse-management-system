# Frontend (public, safe for the browser). NEVER put the service_role / secret key here.
# Local: values printed by `npx supabase status` (API URL and anon key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Edge Function secrets (hosted only; set with `npx supabase secrets set ...`, never in the frontend)
# ALLOWED_ORIGIN=https://your-app.pages.dev
