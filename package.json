{
  "name": "warehouse-cold-storage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "functions:serve": "supabase functions serve",
    "test:concurrency": "bash scripts/test-concurrency.sh",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:db && npm run test:concurrency && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/react": "^10.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "html5-qrcode": "^2.3.8",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.74.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
